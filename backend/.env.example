# Copy to .env and fill values from Supabase + Railway

# From Supabase → Project Settings → Database → Connection string (URI)
# Use the "Transaction" pooler URI if available. Password is your DB password.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# From Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_BUCKET=project-documents

# Comma-separated frontend origins (add your Vercel URL later)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://YOUR_APP.vercel.app

# Login accounts (seeded into app_users on startup; change in production)
# ADMIN_EMAIL=admin@tenderrisk.local
# ADMIN_PASSWORD=Admin123!
# USER_EMAIL=user@tenderrisk.local
# USER_PASSWORD=User123!

# Phase 1 — Canonical Document Model (CDM writer on extraction)
# CDM_ENABLED=false

# Phase 2 — Party / Element Registry / OntologyEdge ingest on extraction
# ONTOLOGY_ENABLED=false

# Phase 3 — PYTHON seed rules (BOQ math, schedule checks, cross-doc presence, …)
# When false (default), only the keyword analyzer runs — BOQ-SEED / SCH-SEED / …
# findings are NOT produced or merged into the report.
# NEW_RULE_ENGINE_ENABLED=false

# Optional LLM (Phase 4 AI/HYBRID rule engine — OpenAI-compatible Chat Completions)
# OPENAI_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# AI_RULE_ENGINE_ENABLED=false

# Phase 4 — AI/HYBRID seed rules (semantic ambiguity + python-first hybrid detectors)
# AI_MAX_CALLS_PER_ANALYSIS=24  → run all 24 rules (default); 0 = unlimited
# LLM_PROVIDER=replay|local_semantic  → offline dev/verify without OPENAI_API_KEY

# Production safety
# MAX_UPLOAD_MB=200  → default cap per file (set 0 only for local dev unlimited)
# Change ADMIN_PASSWORD / USER_PASSWORD / ADMIN_API_TOKEN before deploy!

# Phase C / TI-1 — Semantic standards compliance
# TI_SEMANTIC_STANDARDS_ENABLED=true  → run TI without full KG graph (keyword path skipped)
# KNOWLEDGE_GRAPH_ENABLED=true        → TI + graph edges + related_findings_chain
# Uses LLM meaning-based comparison of ingested Requirement rows vs tender corpus.
# OPENAI_API_KEY required for production; or LLM_PROVIDER=replay|local_semantic for dev/verify.
# TI_MAX_CHECKS_PER_STANDARD=0  → no cap (default); set e.g. 30 for cost control.
#
# Recommended production intelligence flags:
#   TI_SEMANTIC_STANDARDS_ENABLED=true
#   AI_RULE_ENGINE_ENABLED=true
#   NEW_RULE_ENGINE_ENABLED=true
#   KNOWLEDGE_GRAPH_ENABLED=true
#   ONTOLOGY_ENABLED=true
#   ONTOLOGY_ENABLED=true  → ingest Party/ProjectElement/OntologyEdge on document extract
#   KNOWLEDGE_GRAPH_ENABLED=true → related_findings_chain + TI-1 graph + finding→clause edges
#   BOTH true → link_project_standards_to_graph (Project→CatalogStandard/StandardClause governed_by)
#   Finding evidence guardrail runs on every analysis (not flag-gated).
# When both ONTOLOGY_ENABLED and KNOWLEDGE_GRAPH_ENABLED are true, project
# standards are linked to StandardClause nodes via governed_by edges.

# Phase 6 — Risk Knowledge Base DB table + admin GET/PATCH /api/risks
# When false (default), runners use Python seed dicts (Batches 1–2).
# RKB_DB_ENABLED=false

# Phase 7 — Human Construction Experience Knowledge (admin-curated lessons)
# When false (default), experience items are not surfaced in analysis.
# EXPERIENCE_LAYER_ENABLED=false

# Phase 8 — Vision drawing checks (DRAW-SEED-002..004) + GAEB 90 fixed-width
# VISION_DRAWING_CHECKS_ENABLED=false
# GAEB90_ENABLED=false
# VISION_LLM_MODEL=gpt-4o-mini
